
# --- OpenAI provider (default) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Provider selection ---
# Set to "openai" or "ollama". Default: openai
# LLM_PROVIDER=openai

# --- Ollama provider (local) ---
# Uncomment and set LLM_PROVIDER=ollama to use a local Ollama instance.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_HOST=localhost:11434      # alternative to OLLAMA_BASE_URL
# OLLAMA_MODEL=llama3

# --- Per-role model overrides ---
# Override the model used for specific agent roles. If unset, the active
# provider's default model is used for all roles.
# ROUTER_MODEL=llama3
# AGENT_MODEL=llama3:70b
# MEMORY_MODEL=llama3

# --- Agent delegation skills ---
# Timeout in seconds for call_claude / call_cursor_agent / call_opencode.
# Default: 300 (5 minutes)
# SKILL_TIMEOUT_SECS=300

# --- Infrastructure ---
GOSHELL_BIN=../golang-shell/goshell
GCLAW_MEMORY_DIR=./memory
EXA_API_KEY=
SHOW_TOOL_CALLS=true
